# Transcription. Pick at least one; `auto` uses the fastest available.
#   groq   - whisper-large-v3, fastest hosted option
#   openai - whisper-1
#   local  - faster-whisper, needs no key at all
GROQ_API_KEY=
OPENAI_API_KEY=

# Translation and visual analysis
OPENROUTER_API_KEY=

# --- Optional tuning (defaults shown) ---
# Override the ASR model. On Groq, whisper-large-v3-turbo is faster and
# noticeably worse on accented speech, which is why it is not the default.
# VIDA_ASR_MODEL=

# ffmpeg filter chain applied while the audio is extracted. Whisper goes
# silent through wind and traffic rather than guessing, so cleaning the audio
# first is worth about a third more words on noisy footage — and it is what
# keeps VIDA_NO_SPEECH_THRESHOLD below meaningful. Set it empty for clean
# studio audio, where it only costs CPU.
# VIDA_ASR_AUDIO_FILTER=highpass=f=100,afftdn=nr=20:nf=-30,lowpass=f=7000,loudnorm=I=-16:TP=-1.5:LRA=11

# Whisper picks a language per 30-second window and can change its mind
# halfway through a recording. Vida detects once from this many opening
# seconds and pins the answer for the whole file. 0 lets every window decide
# for itself, which only a genuinely multilingual recording wants.
# VIDA_ASR_DETECT_SECONDS=30

# Names and jargon Whisper cannot guess — character names, invented words,
# product names. Comma-separated, because the entries are phrases. Its only
# vocabulary mechanism is the free-text prompt, so these are folded into it.
# VIDA_ASR_GLOSSARY=

# ffmpeg filter applied in the *source* channel layout, before the mono
# downmix — the opposite position from VIDA_ASR_AUDIO_FILTER above, because
# it exploits the channels the downmix destroys. Film dialogue is mixed to
# the 5.1 centre channel, so on a true 5.1 source this drops the score and
# effects bed outright. Off by default: it fails on a source with no FC.
#   pan=mono|c0=FC                  5.1 centre channel only
#   pan=mono|c0=0.5*c0+0.5*c1       stereo approximation, much weaker
# Turning it on moves the noise floor VIDA_NO_SPEECH_THRESHOLD was
# calibrated against, so re-check hallucination rate if you do.
# VIDA_ASR_DIALOGUE_FILTER=

# VIDA_ASR_CHUNK_SECONDS=600

# Cut chunks in the gaps between lines rather than on the clock. The overlap
# already rescues a word split across a seam, so this is the second-order win
# — not splitting it at all — paid for with one silencedetect pass per
# boundary. Measure it with evals/asr before turning it on.
# VIDA_ASR_SILENCE_AWARE_CHUNKING=false
# VIDA_ASR_CHUNK_BOUNDARY_SEARCH=3

# VIDA_ASR_CONCURRENCY=8
# VIDA_TRANSLATION_BATCH_SIZE=40
# VIDA_TRANSLATION_CONCURRENCY=8
# VIDA_ANALYSIS_CONCURRENCY=5
# VIDA_WORK_DIR=

# Whisper invents phrases like "You" over silent audio. Segments it flags as
# non-speech above this probability are dropped; 1.0 keeps everything.
# VIDA_NO_SPEECH_THRESHOLD=0.6

# --- Local (faster-whisper) backend ---
# `auto` runs on the GPU when CUDA works and falls back to the CPU when it does
# not; name a device explicitly and that choice is respected, failures included.
# VIDA_LOCAL_DEVICE=auto          # auto | cuda | cpu
# `auto` means float16 on a GPU, int8 on a CPU.
# VIDA_LOCAL_COMPUTE_TYPE=auto    # auto | float16 | int8 | int8_float16

# --- Demo backend only ---
# VIDA_CORS_ORIGINS=http://localhost:3000
# VIDA_UPLOAD_DIR=/tmp/vida_uploads
# VIDA_MAX_UPLOAD_MB=1024
