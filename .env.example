# Transcription. Pick at least one; `auto` uses the fastest available.
#   groq   - whisper-large-v3-turbo, fastest hosted option
#   openai - whisper-1
#   local  - faster-whisper, needs no key at all
GROQ_API_KEY=
OPENAI_API_KEY=

# Translation and visual analysis
OPENROUTER_API_KEY=

# --- Optional tuning (defaults shown) ---
# VIDA_ASR_CHUNK_SECONDS=600
# VIDA_ASR_CONCURRENCY=8
# VIDA_TRANSLATION_BATCH_SIZE=40
# VIDA_TRANSLATION_CONCURRENCY=8
# VIDA_ANALYSIS_CONCURRENCY=5
# VIDA_WORK_DIR=

# Whisper invents phrases like "You" over silent audio. Segments it flags as
# non-speech above this probability are dropped; 1.0 keeps everything.
# VIDA_NO_SPEECH_THRESHOLD=0.6

# --- Local (faster-whisper) backend ---
# `auto` runs on the GPU when CUDA works and falls back to the CPU when it does
# not; name a device explicitly and that choice is respected, failures included.
# VIDA_LOCAL_DEVICE=auto          # auto | cuda | cpu
# `auto` means float16 on a GPU, int8 on a CPU.
# VIDA_LOCAL_COMPUTE_TYPE=auto    # auto | float16 | int8 | int8_float16

# --- Demo backend only ---
# VIDA_CORS_ORIGINS=http://localhost:3000
# VIDA_UPLOAD_DIR=/tmp/vida_uploads
# VIDA_MAX_UPLOAD_MB=1024
